+  timeSeconds,
+}: {
+  anchorKeyframeId: string;
+  durationSeconds: number;
+  keyframeGroups: readonly ToolcraftTimelineKeyframeGroup[];
+  selectedKeyframeIds: readonly string[];
+  timeSeconds: number;
